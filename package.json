{
  "name": "@pactflow/pact-cypress-adapter",
  "version": "2.0.0",
  "description": "A cypress adapter for pact",
  "keywords": [
    "pact",
    "cypress",
    "contract testing",
    "ui"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "fmt": "biome format .",
    "fmt:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write --unsafe .",
    "test:example": "cd example/todo-example && npm i && npm run check && npm run build && npm run http-server && npm run cypress:run",
    "check:pack": "node scripts/check-pack.mts"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/lodash": "4.17.26",
    "@types/node": "24.19.2",
    "@vitest/ui": "5.0.5",
    "cypress": "16.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "cypress": ">=12.17.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pactflow/pact-cypress-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/pactflow/pact-cypress-adapter/issues"
  },
  "homepage": "https://github.com/pactflow/pact-cypress-adapter#readme"
}
