{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "strict": true,
    "noImplicitReturns": true,
    "module": "node20",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "declaration": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node", "cypress"],
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
